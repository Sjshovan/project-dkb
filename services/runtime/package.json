{
  "name": "@dkb/runtime",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*",
      "import": "./dist/*"
    }
  },
  "bin": {
    "dkb-runtime": "./dist/bin.js"
  },
  "files": [
    "dist/",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false"
  },
  "dependencies": {
    "@dkb/library": "0.1.0",
    "@dkb/pipeline": "0.1.0",
    "@dkb/protocol": "1.0.0",
    "@dkb/providers-bundled": "0.1.0",
    "@dkb/registry-client": "0.1.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
