{
  "name": "@sjshovan/dkb-runtime",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*",
      "import": "./dist/*"
    }
  },
  "bin": {
    "dkb-runtime": "./dist/bin.js"
  },
  "files": [
    "dist/",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@sjshovan/dkb-distribution-default": "0.1.0",
    "@sjshovan/dkb-library": "0.1.0",
    "@sjshovan/dkb-pipeline": "0.1.0",
    "@sjshovan/dkb-protocol": "1.0.0",
    "@sjshovan/dkb-providers-bundled": "0.1.0",
    "@sjshovan/dkb-registry-client": "0.1.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sjshovan/project-dkb.git"
  },
  "homepage": "https://github.com/Sjshovan/project-dkb",
  "bugs": {
    "url": "https://github.com/Sjshovan/project-dkb/issues"
  }
}
