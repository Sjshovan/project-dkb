{
  "name": "@dkb/library",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*",
      "import": "./dist/*"
    }
  },
  "files": [
    "dist/",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false"
  },
  "dependencies": {
    "@dkb/pipeline": "0.1.0",
    "@dkb/protocol": "1.0.0",
    "@dkb/providers-bundled": "0.1.0",
    "tar": "^7.5.22"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
