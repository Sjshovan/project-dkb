{
  "name": "@sjshovan/dkb-library",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    "./sourceRevisions.js": { "types": "./dist/sourceRevisions.d.ts", "import": "./dist/sourceRevisions.js" },
    "./append.js": { "types": "./dist/append.d.ts", "import": "./dist/append.js" },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/adapter.js": { "types": "./dist/adapters/adapter.d.ts", "import": "./dist/adapters/adapter.js" },
    "./adapters/compose.js": { "types": "./dist/adapters/compose.d.ts", "import": "./dist/adapters/compose.js" },
    "./adapters/folder.js": { "types": "./dist/adapters/folder.d.ts", "import": "./dist/adapters/folder.js" },
    "./adapters/index.js": { "types": "./dist/adapters/index.d.ts", "import": "./dist/adapters/index.js" },
    "./adapters/postgres.js": { "types": "./dist/adapters/postgres.d.ts", "import": "./dist/adapters/postgres.js" },
    "./adapters/sqlite.js": { "types": "./dist/adapters/sqlite.d.ts", "import": "./dist/adapters/sqlite.js" },
    "./archive.js": { "types": "./dist/archive.d.ts", "import": "./dist/archive.js" },
    "./builds.js": { "types": "./dist/builds.d.ts", "import": "./dist/builds.js" },
    "./locks.js": { "types": "./dist/locks.d.ts", "import": "./dist/locks.js" },
    "./mutation.js": { "types": "./dist/mutation.d.ts", "import": "./dist/mutation.js" },
    "./collections.js": { "types": "./dist/collections.d.ts", "import": "./dist/collections.js" },
    "./evidenceCatalog.js": { "types": "./dist/evidenceCatalog.d.ts", "import": "./dist/evidenceCatalog.js" },
    "./oci.js": { "types": "./dist/oci.d.ts", "import": "./dist/oci.js" },
    "./overview.js": { "types": "./dist/overview.d.ts", "import": "./dist/overview.js" },
    "./packageInfo.js": { "types": "./dist/packageInfo.d.ts", "import": "./dist/packageInfo.js" },
    "./packageTree.js": { "types": "./dist/packageTree.d.ts", "import": "./dist/packageTree.js" },
    "./resolver.js": { "types": "./dist/resolver.d.ts", "import": "./dist/resolver.js" },
    "./root.js": { "types": "./dist/root.d.ts", "import": "./dist/root.js" },
    "./signing.js": { "types": "./dist/signing.d.ts", "import": "./dist/signing.js" },
    "./state.js": { "types": "./dist/state.d.ts", "import": "./dist/state.js" },
    "./storage.js": { "types": "./dist/storage.d.ts", "import": "./dist/storage.js" },
    "./storageAccess.js": { "types": "./dist/storageAccess.d.ts", "import": "./dist/storageAccess.js" }
  },
  "files": [
    "dist/",
    "platform/windows-volume-probe.js",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false"
  },
  "dependencies": {
    "@sjshovan/dkb-protocol": "2.0.0",
    "tar": "^7.5.22"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sjshovan/project-dkb.git"
  },
  "homepage": "https://github.com/Sjshovan/project-dkb",
