{
  "name": "@sjshovan/dkb-registry-client",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client.js": { "types": "./dist/client.d.ts", "import": "./dist/client.js" },
    "./collections.js": { "types": "./dist/collections.d.ts", "import": "./dist/collections.js" },
    "./config.js": { "types": "./dist/config.d.ts", "import": "./dist/config.js" },
    "./credentials.js": { "types": "./dist/credentials.d.ts", "import": "./dist/credentials.js" }
  },
  "files": [
    "dist/",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false"
  },
  "dependencies": {
    "@sjshovan/dkb-library": "0.2.0",
    "@sjshovan/dkb-protocol": "2.0.0",
    "tar": "^7.5.22"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sjshovan/project-dkb.git"
  },
  "homepage": "https://github.com/Sjshovan/project-dkb",
  "bugs": {
    "url": "https://github.com/Sjshovan/project-dkb/issues"
  }
}
