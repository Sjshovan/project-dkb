{
  "name": "@sjshovan/dkb-pipeline",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./buildProfiles.js": { "types": "./dist/buildProfiles.d.ts", "import": "./dist/buildProfiles.js" },
    "./config.js": { "types": "./dist/config.d.ts", "import": "./dist/config.js" },
    "./host.js": { "types": "./dist/host.d.ts", "import": "./dist/host.js" },
    "./profile.js": { "types": "./dist/profile.d.ts", "import": "./dist/profile.js" },
    "./types.js": { "types": "./dist/types.d.ts", "import": "./dist/types.js" }
  },
  "files": [
    "dist/",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false"
  },
  "dependencies": {
    "@sjshovan/dkb-protocol": "2.0.0"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sjshovan/project-dkb.git"
  },
  "homepage": "https://github.com/Sjshovan/project-dkb",
  "bugs": {
    "url": "https://github.com/Sjshovan/project-dkb/issues"
  }
}
