    "./schemas/dkb-library-lock.schema.json": "./schemas/dkb-library-lock.schema.json",
    "./schemas/dkb-lock.schema.json": "./schemas/dkb-lock.schema.json",
    "./schemas/dkb-read-request.schema.json": "./schemas/dkb-read-request.schema.json",
    "./schemas/dkb.schema.json": "./schemas/dkb.schema.json",
    "./schemas/query.schema.json": "./schemas/query.schema.json",
    "./schemas/result.schema.json": "./schemas/result.schema.json"
  },
  "files": [
    "dist/",
    "!dist/.tsbuildinfo",
    "schemas/"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sjshovan/project-dkb.git"
  },
  "homepage": "https://github.com/Sjshovan/project-dkb",
  "bugs": {
    "url": "https://github.com/Sjshovan/project-dkb/issues"
  }
