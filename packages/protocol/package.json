    "./contracts/index.js": { "types": "./dist/contracts/index.d.ts", "import": "./dist/contracts/index.js" },
    "./contracts/validation.js": { "types": "./dist/contracts/validation.d.ts", "import": "./dist/contracts/validation.js" },
    "./errors.js": { "types": "./dist/errors.d.ts", "import": "./dist/errors.js" },
    "./evidence/catalog.js": { "types": "./dist/evidence/catalog.d.ts", "import": "./dist/evidence/catalog.js" },
    "./evidence/ir.js": { "types": "./dist/evidence/ir.d.ts", "import": "./dist/evidence/ir.js" },
    "./identity.js": { "types": "./dist/identity.d.ts", "import": "./dist/identity.js" },
    "./manifest.js": { "types": "./dist/manifest.d.ts", "import": "./dist/manifest.js" },
    "./paths.js": { "types": "./dist/paths.d.ts", "import": "./dist/paths.js" },
    "./progress.js": { "types": "./dist/progress.d.ts", "import": "./dist/progress.js" },
    "./retrievalProfile.js": { "types": "./dist/retrievalProfile.d.ts", "import": "./dist/retrievalProfile.js" },
    "./security/sourceContent.js": { "types": "./dist/security/sourceContent.d.ts", "import": "./dist/security/sourceContent.js" },
    "./space.js": { "types": "./dist/space.d.ts", "import": "./dist/space.js" },
    "./types.js": { "types": "./dist/types.d.ts", "import": "./dist/types.js" },
    "./validation.js": { "types": "./dist/validation.d.ts", "import": "./dist/validation.js" },
    "./version.js": { "types": "./dist/version.d.ts", "import": "./dist/version.js" },
    "./writeGate.js": { "types": "./dist/writeGate.d.ts", "import": "./dist/writeGate.js" },
