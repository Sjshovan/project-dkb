{
  "name": "@sjshovan/dkb-protocol",
  "version": "2.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./artifacts.js": { "types": "./dist/artifacts.d.ts", "import": "./dist/artifacts.js" },
