{
  "name": "@sjshovan/dkb-protocol",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*",
      "import": "./dist/*"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist/",
    "!dist/.tsbuildinfo",
    "schemas/"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sjshovan/project-dkb.git"
  },
  "homepage": "https://github.com/Sjshovan/project-dkb",
  "bugs": {
    "url": "https://github.com/Sjshovan/project-dkb/issues"
  }
}
