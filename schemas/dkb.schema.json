{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codename-dkb.local/schemas/dkb.schema.json",
  "title": "DKB Library Entry Manifest",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-[A-Za-z0-9._-]+$": true
  },
  "required": ["type", "name"],
  "properties": {
    "manifestVersion": { "type": "integer", "minimum": 1 },
    "type": { "enum": ["dkb", "collection", "library"] },
    "name": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "version": { "$ref": "#/$defs/exactVersion" },
    "description": { "type": "string" },
    "namespace": { "type": "string", "minLength": 1 },
    "appId": { "type": "string", "minLength": 1 },
    "owner": { "$ref": "#/$defs/owner" },
    "author": { "$ref": "#/$defs/owner" },
    "license": { "type": "string", "minLength": 1 },
    "members": { "$ref": "#/$defs/members" },
    "roots": { "$ref": "#/$defs/roots" },
    "collectionOverrides": { "$ref": "#/$defs/collectionOverrides" },
    "registry": { "$ref": "#/$defs/registry" },
    "localSources": { "$ref": "#/$defs/localSources" },
    "retrievalProfile": { "$ref": "#/$defs/retrievalProfile" },
    "permissions": { "$ref": "#/$defs/permissions" },
    "domains": { "$ref": "#/$defs/stringList" },
    "roles": { "$ref": "#/$defs/stringList" },
    "write": { "$ref": "#/$defs/write" },
    "meta": { "type": "object", "additionalProperties": true }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "dkb" } },
        "required": ["type"]
      },
      "then": {
        "required": ["version"],
        "properties": { "name": { "$ref": "#/$defs/identity" } },
        "not": {
          "anyOf": [
            { "required": ["members"] },
            { "required": ["roots"] },
            { "required": ["collectionOverrides"] },
            { "required": ["registry"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "collection" } },
        "required": ["type"]
      },
      "then": {
        "required": ["members"],
        "properties": { "name": { "$ref": "#/$defs/identity" } },
        "not": {
          "anyOf": [
            { "required": ["version"] },
            { "required": ["roots"] },
            { "required": ["collectionOverrides"] },
            { "required": ["registry"] },
            { "required": ["localSources"] },
            { "required": ["permissions"] },
            { "required": ["write"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "library" } },
        "required": ["type"]
      },
      "then": {
        "required": ["roots"],
        "not": {
          "anyOf": [
            { "required": ["version"] },
            { "required": ["members"] },
            { "required": ["localSources"] },
            { "required": ["permissions"] },
            { "required": ["write"] }
          ]
        }
      }
    }
  ],
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^@[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?/[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "exactVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "versionSelector": {
      "oneOf": [
        { "const": "latest" },
        { "$ref": "#/$defs/exactVersion" }
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 3 },
        "url": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 }
      }
    },
    "members": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identity" },
      "additionalProperties": { "$ref": "#/$defs/versionSelector" }
    },
    "roots": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identity" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "version": { "$ref": "#/$defs/versionSelector" },
          "revision": {
            "oneOf": [
              { "const": "latest" },
              { "type": "integer", "minimum": 1 }
            ]
          }
        },
        "oneOf": [
          { "required": ["path"], "not": { "anyOf": [{ "required": ["version"] }, { "required": ["revision"] }] } },
          { "required": ["version"], "not": { "anyOf": [{ "required": ["path"] }, { "required": ["revision"] }] } },
          { "required": ["revision"], "not": { "anyOf": [{ "required": ["path"] }, { "required": ["version"] }] } }
        ]
      }
    },
    "collectionOverrides": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identity" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "include": { "$ref": "#/$defs/members" },
          "exclude": {
            "type": "array",
            "items": { "$ref": "#/$defs/identity" },
            "uniqueItems": true
          }
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^https?://" }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read": { "type": "boolean" },
        "write": { "type": "boolean" }
      }
    },
    "localSources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "root": { "type": "string", "minLength": 1 },
        "excludes": { "$ref": "#/$defs/stringList" }
      }
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "retrievalProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compiler": { "enum": ["llamaindex"] },
        "embedding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "adapter": { "enum": ["fastembed"] },
            "model": { "type": "string", "minLength": 1 },
            "dimensions": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "write": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "operations"],
      "properties": {
        "mode": { "enum": ["queued", "direct"] },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["write", "append", "delete", "update", "supersede"] },
          "uniqueItems": true
        },
        "accepts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lanes": { "$ref": "#/$defs/stringList" },
            "subjects": { "$ref": "#/$defs/stringList" },
            "intents": { "$ref": "#/$defs/stringList" },
            "recordTypes": { "$ref": "#/$defs/stringList" }
          }
        },
        "dedupe": { "enum": ["required", "optional", "none"] },
        "schema": { "type": "string", "minLength": 1 },
        "confirmationRequired": { "type": "boolean" }
      }
    }
  }
}
