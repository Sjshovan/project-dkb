{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codename-dkb.local/schemas/dkb.schema.json",
  "title": "dkb.json Manifest",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-[A-Za-z0-9._-]+$": true
  },
  "required": ["name"],
  "properties": {
    "manifestVersion": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": ["package", "registry"]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "package": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "appId": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "$ref": "#/$defs/owner"
    },
    "author": {
      "$ref": "#/$defs/owner"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "collection": {
      "$ref": "#/$defs/collection"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "permissions": {
      "$ref": "#/$defs/permissions"
    },
    "domains": {
      "$ref": "#/$defs/stringList"
    },
    "roles": {
      "$ref": "#/$defs/stringList"
    },
    "write": {
      "$ref": "#/$defs/write"
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "minLength": 3
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "collection": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "anyOf": [
            {
              "required": ["id"]
            },
            {
              "required": ["name"]
            }
          ]
        }
      ]
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read": {
          "type": "boolean"
        },
        "write": {
          "type": "boolean"
        }
      }
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "write": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "operations"],
      "properties": {
        "mode": {
          "enum": ["queued", "direct"]
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["write", "append", "delete", "update", "supersede"]
          },
          "uniqueItems": true
        },
        "accepts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lanes": {
              "$ref": "#/$defs/stringList"
            },
            "subjects": {
              "$ref": "#/$defs/stringList"
            },
            "intents": {
              "$ref": "#/$defs/stringList"
            },
            "recordTypes": {
              "$ref": "#/$defs/stringList"
            }
          }
        },
        "dedupe": {
          "enum": ["required", "optional", "none"]
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "confirmationRequired": {
          "type": "boolean"
        }
      }
    }
  }
}
