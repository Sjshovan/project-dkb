{
  "name": "project-dkb",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "providers/*"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && npm run build --workspace @dkb/protocol && npm run build --workspace @dkb/pipeline && npm run build --workspace @dkb/providers-bundled && npm run build --workspace @dkb/library && npm run build --workspace @dkb/registry-client && npm run build --workspace @dkb/compiler && npm run build --workspace @dkb/runtime && npm run build --workspace @dkb/cli",
    "check": "npm run check --workspace @dkb/protocol && npm run check --workspace @dkb/pipeline && npm run check --workspace @dkb/providers-bundled && npm run check --workspace @dkb/library && npm run check --workspace @dkb/registry-client && npm run check --workspace @dkb/compiler && npm run check --workspace @dkb/runtime && npm run check --workspace @dkb/cli",
    "test": "npm run build && node --test tests/*.test.mjs",
    "proof:pipeline": "npm run build && node scripts/prove-provider-pipeline.mjs",
    "proof:stack": "npm run build && node scripts/prove-stack-lifecycle.mjs",
    "proof:multispace": "npm run build && node scripts/prove-multispace-lifecycle.mjs",
    "proof:cli": "npm run build && node scripts/prove-cli-distribution.mjs",
    "proof:real-corpus": "npm run build && node scripts/prove-real-corpus.mjs",
    "benchmark:embeddings": "npm run build && node scripts/benchmark-embedding-providers.mjs",
    "benchmark:scale": "npm run build && node scripts/benchmark-corpus-scale.mjs",
    "temp:audit": "node scripts/clean-dkb-temp.mjs",
    "temp:clean": "node scripts/clean-dkb-temp.mjs --apply",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "version:status": "changeset status",
    "graph:write": "node scripts/workspace-graph.mjs",
    "graph:check": "node scripts/workspace-graph.mjs --check",
    "boundaries:check": "node scripts/check-package-boundaries.mjs",
    "agents:check": "node scripts/check-agent-guidance.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "package:check": "node scripts/check-packages.mjs",
    "dkb": "node apps/cli/dist/cli/index.js",
    "mcp": "node apps/cli/dist/cli/index.js mcp serve"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.2",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
