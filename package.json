{
  "name": "project-dkb",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "providers/*"
  ],
  "bin": {
    "dkb": "./dist/src/cli/index.js"
  },
  "files": [
    "dist/",
    "!dist/src/testing/",
    "schemas/",
    "compiler/llamaindex/compile.py",
    "compiler/llamaindex/embedder.py",
    "compiler/llamaindex/service.py",
    "compiler/llamaindex/requirements.txt",
    "compiler/llamaindex/Dockerfile",
    "compiler/llamaindex/Dockerfile.gpu"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && npm run build --workspace @dkb/protocol && npm run build --workspace @dkb/pipeline && npm run build --workspace @dkb/library && tsc -p tsconfig.build.json",
    "check": "npm run check --workspace @dkb/protocol && npm run check --workspace @dkb/pipeline && npm run check --workspace @dkb/library && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "proof:pipeline": "npm run build && node scripts/prove-provider-pipeline.mjs",
    "proof:lifecycle": "npm run build && node scripts/prove-package-lifecycle.mjs",
    "proof:meilisearch": "npm run build && node scripts/prove-meilisearch-lifecycle.mjs",
    "temp:audit": "node scripts/clean-dkb-temp.mjs",
    "temp:clean": "node scripts/clean-dkb-temp.mjs --apply",
    "dkb": "node dist/src/cli/index.js",
    "mcp": "node dist/src/cli/index.js mcp serve"
  },
  "dependencies": {
    "@dkb/library": "0.1.0",
    "@dkb/pipeline": "0.1.0",
    "@dkb/protocol": "1.0.0",
    "@lancedb/lancedb": "^0.30.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "ajv": "^8.17.1",
    "chokidar": "^5.0.0",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "graphology": "^0.26.0",
    "meilisearch": "^0.53.0",
    "ora": "^9.4.1",
    "pg": "^8.22.0",
    "tar": "^7.5.22",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.21.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
