{
  "name": "@sjshovan/dkb-console",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./launcher.js": {
      "types": "./dist/server/launcher.d.ts",
      "import": "./dist/server/launcher.js"
    },
    "./autostart.js": {
      "types": "./dist/server/autostart.d.ts",
      "import": "./dist/server/autostart.js"
    }
  },
  "bin": {
    "dkb-console": "./dist/server/bin.js"
  },
  "files": [
    "dist/server/",
    "dist/web/"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -b tsconfig.server.json",
    "build:web": "vite build",
    "check": "tsc -b tsconfig.server.json --pretty false && vue-tsc -p tsconfig.web.json --noEmit",
    "dev": "vite"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@lucide/vue": "^1.37.0",
    "@sjshovan/dkb-protocol": "2.0.0",
    "@tanstack/vue-query": "^5.102.8",
    "@tanstack/vue-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "datatables.net-columncontrol-dt": "^2.0.1",
    "datatables.net-dt": "^3.0.3",
    "datatables.net-responsive-dt": "^4.0.2",
    "datatables.net-vue3": "^3.0.8",
    "fastify": "^5.12.1",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
