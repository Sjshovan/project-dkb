{
  "name": "@sjshovan/dkb-providers-bundled",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*",
      "import": "./dist/*"
    }
  },
  "files": [
    "dist/",
    "!dist/.tsbuildinfo",
    "python/faiss/faiss_helper.py"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.30.0",
    "@sjshovan/dkb-evidence-docling-llamaindex": "0.1.0",
    "@sjshovan/dkb-pipeline": "0.1.0",
    "@sjshovan/dkb-protocol": "1.0.0",
    "meilisearch": "^0.53.0"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sjshovan/project-dkb.git"
  },
  "homepage": "https://github.com/Sjshovan/project-dkb",
  "bugs": {
    "url": "https://github.com/Sjshovan/project-dkb/issues"
  }
}
